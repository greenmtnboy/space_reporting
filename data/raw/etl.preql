# shared concepts
# `timestamp`, not `datetime`: the update date is UTC-aware (see
# ingest_core.parse_data_update_date), which duckdb stores as TIMESTAMP WITH
# TIME ZONE - the type every published parquet already holds.
property <*>.data_updated_through timestamp; # date when the data was last updated

root datasource data_update_info (
    data_update_date: data_updated_through
    )
file `ingest_update_date.py`
;

def extract_date(col)-> CASE 
        WHEN TRIM(REGEXP_EXTRACT(REPLACE(col, '?', ''), '(\d{4}\s+[A-Za-z]{3}\s+\d{1,2})', 1)) IS NOT NULL 
             AND LEN(TRIM(REGEXP_EXTRACT(REPLACE(col, '?', ''), '(\d{4}\s+[A-Za-z]{3}\s+\d{1,2})', 1))) > 0
        THEN parse_time(
            TRIM(REGEXP_EXTRACT(REPLACE(col, '?', ''), '(\d{4}\s+[A-Za-z]{3}\s+\d{1,2})', 1)),
            '%Y %b %d'
        )
        ELSE NULL
    END::date;

# GCAT lists a joint attribution as slash-joined org codes ('AFSSD/MSC'). The
# composed string is kept as-is; the organization a row joins to is the first
# code. '-' (none) stays a code of its own, with its own organizations row.
def first_code(codes) -> split(codes, '/')[1];
